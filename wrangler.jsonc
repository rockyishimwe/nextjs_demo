{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nextjs-demo",
  "main": ".worker/index.js",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".worker/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}
